{
  "name": "@natanga/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design system accessible : tokens, typographie dyslexie-friendly, composants React réutilisables",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
