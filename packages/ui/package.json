    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-native": ">=0.75"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "rimraf": "^6.0.0"
  }
}
