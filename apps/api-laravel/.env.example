# Natanga API Laravel — variables d'environnement (copier en .env)

APP_NAME=Natanga
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Connexion PostgreSQL (même BDD que le schéma Prisma).
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=natanga
DB_USERNAME=natanga
DB_PASSWORD=

# Cache / session (fichier local en dev).
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
