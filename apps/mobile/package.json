{
  "name": "@natanga/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile Natanga — React Native (Expo)",
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .expo dist"
  },
  "dependencies": {
    "@natanga/core": "workspace:*",
    "@natanga/ui": "workspace:*",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-speech": "~13.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
