{
  "name": "@natanga/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile Natanga \u2014 React Native (Expo)",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .expo dist",
    "icons": "node scripts/generate-icons.mjs",
    "export:web": "expo export -p web"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-speech": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/lucide": "^1.2.138",
    "@types/react": "^18.3.31",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
