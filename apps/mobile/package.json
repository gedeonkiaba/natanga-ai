{
  "name": "@natanga/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile Natanga \u2014 React Native (Expo)",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .expo dist",
    "icons": "node scripts/generate-icons.mjs",
    "export:web": "expo export -p web"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@natanga/core": "workspace:*",
    "@natanga/ui": "workspace:*",
    "expo": "~57.0.26",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/lucide": "^1.2.138",
    "@types/react": "~19.2.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
