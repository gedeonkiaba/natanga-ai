# Secrets de production — copier en .env.prod (jamais versionné).
PUBLIC_URL=https://app.natanga.example
# Domaine servi par Caddy (certificat TLS automatique ; DNS pointant vers le serveur)
PUBLIC_DOMAIN=app.natanga.example
# php artisan key:generate --show
APP_KEY=
DB_PASSWORD=
# Fournisseur email transactionnel (Brevo, Postmark, Mailjet, SES… hébergé UE de préférence)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bonjour@natanga.example
