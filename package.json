{
  "name": "natanga",
  "version": "0.1.0",
  "private": true,
  "description": "Natanga — apprentissage de la lecture et de l'écriture (6-12 ans, dyslexie/dysorthographie/TDAH)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@natanga/web",
    "dev:api": "turbo run dev --filter=@natanga/api",
    "dev:mobile": "turbo run dev --filter=@natanga/mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  }
}
